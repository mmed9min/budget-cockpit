{
  "welcomeFile": "/budgets/index.html",
  "routes": [
    {
      "source": "^/budgets/(.*)$",
      "target": "$1",
      "localDir": "resources/budgets",
      "authenticationType": "xsuaa"
    },
    {
      "source": "^/(.*)$",
      "target": "$1",
      "destination": "srv-api",
      "authenticationType": "xsuaa",
      "csrfProtection": true
    }
  ]
}