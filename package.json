{
  "name": "budget-cockpit",
  "version": "1.0.0",
  "description": "Budget monitoring cockpit - SAP BTP extension for S/4HANA Finance (CO)",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "cds-serve",
    "watch": "cds watch"
  },
  "dependencies": {
    "@cap-js/hana": "^3",
    "@sap-cloud-sdk/connectivity": "^4",
    "@sap-cloud-sdk/http-client": "^4.9.1",
    "@sap-cloud-sdk/resilience": "^4.9.1",
    "@sap/cds": "^10.2.1",
    "@sap/xssec": "^4",
    "express": "^5.3.0"
  },
  "devDependencies": {
    "@cap-js/sqlite": "^3.1.2",
    "@sap/cds-dk": "^10"
  },
  "cds": {
    "requires": {
      "[development]": {
        "auth": {
          "kind": "mocked",
          "users": {
            "controller": { "password": "", "roles": ["BudgetController"] },
            "camille":    { "password": "", "roles": ["CostCenterOwner"] },
            "lucas":      { "password": "", "roles": ["CostCenterOwner"] }
          }
        }
      },
      "[production]": {
        "auth": { "kind": "xsuaa" },
        "db": { "kind": "hana" },
        "destinations": true
      },
      "API_JOURNALENTRYITEMBASIC_SRV": {
        "kind": "odata-v2",
        "model": "srv/external/API_JOURNALENTRYITEMBASIC_SRV",
        "[production]": {
          "credentials": {
            "destination": "S4HANA_FINANCE",
            "path": "/sap/opu/odata/sap/API_JOURNALENTRYITEMBASIC_SRV"
          }
        }
      }
    }
  }
}