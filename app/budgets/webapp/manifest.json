{
  "_version": "1.65.0",
  "sap.app": {
    "id": "budget.cockpit.budgets",
    "type": "application",
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "applicationVersion": { "version": "1.0.0" },
    "dataSources": {
      "mainService": {
        "uri": "/odata/v4/budget-cockpit/",
        "type": "OData",
        "settings": { "odataVersion": "4.0" }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "deviceTypes": { "desktop": true, "tablet": true, "phone": true }
  },
  "sap.ui5": {
    "flexEnabled": true,
    "dependencies": {
      "minUI5Version": "1.120.0",
      "libs": { "sap.m": {}, "sap.ui.core": {}, "sap.fe.templates": {} }
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": { "bundleName": "budget.cockpit.budgets.i18n.i18n" }
      },
      "": {
        "dataSource": "mainService",
        "preload": true,
        "settings": { "operationMode": "Server", "autoExpandSelect": true, "earlyRequests": true }
      }
    },
    "routing": {
      "routes": [
        { "pattern": ":?query:", "name": "BudgetsList", "target": "BudgetsList" },
        { "pattern": "Budgets({key}):?query:", "name": "BudgetsObjectPage", "target": "BudgetsObjectPage" }
      ],
      "targets": {
        "BudgetsList": {
          "type": "Component",
          "id": "BudgetsList",
          "name": "sap.fe.templates.ListReport",
          "options": {
            "settings": {
              "contextPath": "/Budgets",
              "variantManagement": "Page",
              "initialLoad": "Enabled",
              "navigation": { "Budgets": { "detail": { "route": "BudgetsObjectPage" } } }
            }
          }
        },
        "BudgetsObjectPage": {
          "type": "Component",
          "id": "BudgetsObjectPage",
          "name": "sap.fe.templates.ObjectPage",
          "options": { "settings": { "contextPath": "/Budgets" } }
        }
      }
    }
  }
}